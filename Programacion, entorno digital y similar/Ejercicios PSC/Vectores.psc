Algoritmo Vectores
	
	Definir vnombres Como Caracter;
	Definir i, TAM Como Entero;
	TAM=5;
	dimension vnombres[TAM];
	
	
	Para i=0 Hasta (TAM-1) Con Paso 1 Hacer
		Escribir "Dime el nombre " i "º para guardarlo";
		leer vnombres[i];
	Fin Para
	
	Para i=0 Hasta (TAM-1) Con Paso 1 Hacer
		Escribir "El nombre guardado en la posicion " i "º es " vnombres[i];
	Fin Para
	
	
FinAlgoritmo
