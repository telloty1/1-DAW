
Algoritmo Ejercicio1_1
	
	Definir variableA, variableB, aux Como entero;
	
	Escribir "Escribe la Variable A: ";
	leer variableA;
	
	Escribir "Escrible la Variable B: ";
	leer variableB;
	
	aux = variableA;
	variableA = variableB;
	variableB = aux;
	

	
	Escribir "La variable A es: " variableA " y la variable B es: " variableB;
	
	
	
FinAlgoritmo
