Algoritmo Ejercicio1_13
    Definir n, suma, i Como Entero;
    
    Escribir "Escribe la cantidad de numeros naturales: ";
    Leer n;
    
    suma = 0;
    
    Para i = 1 Hasta n Hacer
        suma = suma + i;
    FinPara
    
    Escribir "La suma de los primeros ", n, " numeros naturales es: ", suma;
FinAlgoritmo
