Algoritmo Ejercicio1_5

	Definir n1, n2, n3 Como Entero;

	Escribir "Dime el primer numero";
	leer n1;

	Escribir "Dime el segundo numero";
	leer n2;

	Escribir "Dime el tercer numero";
	leer n3;


	Si (n1<0) Entonces
		Escribir "El producto de los 3 es:", n1*n2*n3;
	Sino
		Escribir "La suma de los 3 es: ", n1+n2+n3;
	FinSi


FinAlgoritmo