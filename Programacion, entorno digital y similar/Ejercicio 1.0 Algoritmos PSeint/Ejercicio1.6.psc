Algoritmo Ejercicio1_4
	
	Definir n1 Como Entero;
	
	Escribir "Dime un numero";
	leer n1;
	
	
	Si (n1>0) Entonces
		
		Escribir "Su cuadrado es: " n1*n1 " y su raiz es: " raiz(n1); 
		
	Sino
		Escribir "Error. El numero no puede ser igual o menor que 0"; 
		Esperar 1 Segundos;
		Escribir "El programa se cerrara en 3";
		Esperar 1 Segundos;
		Escribir "El programa se cerrara en 2";
		Esperar 1 Segundos;
		Escribir "El programa se cerrara en 1";
		Esperar 1 Segundos;
	FinSi
		FinAlgoritmo
	

